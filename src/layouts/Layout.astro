---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="A modern astrology brand: Sacred Cosmos" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Space+Grotesk:wght@400;700;900&display=swap" rel="stylesheet">
    
    <title>{title}</title>
  </head>
  <body>
    <!-- SVG Noise overlay -->
    <div class="noise-overlay"></div>
    
    <!-- Main content container -->
    <div class="max-w-3xl mx-auto px-6 py-12 md:py-20 relative z-10 min-h-screen flex flex-col">
      <header class="mb-16">
        <a href="/" class="group inline-block">
          <h1 class="text-3xl md:text-5xl font-serif font-black tracking-tighter uppercase text-zinc-100 group-hover:text-fuchsia-500 transition-colors duration-300">
            Sacred Cosmos
          </h1>
          <div class="h-1 w-0 bg-fuchsia-500 mt-2 transition-all duration-300 group-hover:w-full"></div>
        </a>
      </header>
      
      <div class="flex-grow">
        <slot />
      </div>

      <footer class="mt-20 border-t border-zinc-900 pt-8 text-center md:text-left flex flex-col md:flex-row justify-between items-center text-xs font-mono text-zinc-600 uppercase tracking-widest gap-4">
        <p>&copy; 2026 Sacred Cosmos</p>
        <p>The Void Beckons.</p>
      </footer>
    </div>
  </body>
</html>
