---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import { marked } from 'marked';

export const prerender = false; // Strictly SSR

const { date } = Astro.params;

// Fetch the specific post by date
const { data: post, error } = await supabase
  .from('daily_blogs')
  .select('*')
  .eq('publish_date', date)
  .single();

if (error || !post) {
  // Return a 404 response natively via Astro
  return new Response("Not found", {
    status: 404,
    statusText: 'Not found'
  });
}

// Parse markdown to HTML
const contentHtml = marked.parse(post.content || '');

// Format Date correctly regardless of local timezone
const formatDate = (dateStr: string) => {
  const d = new globalThis.Date(dateStr);
  return new Intl.DateTimeFormat('en-US', {
    weekday: 'long',
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC' // Assuming the date from DB is treated as UTC YYYY-MM-DD
  }).format(d);
};

const displayDate = formatDate(post.publish_date);

// Basic plain text snippet for description (strips basic markdown chars for og:description)
const excerpt = post.content 
  ? post.content.replace(/[#*`_\[\]()]/g, '').substring(0, 160).trim() + '...' 
  : "Daily cosmic insights.";
---

<Layout 
  title={`${post.theme_title} | Sacred Cosmos`}
  description={excerpt}
  image={post.hero_image_url}
  type="article"
  publishDate={post.publish_date}
>
  <article class="max-w-none fade-in">
    <header class="mb-8 md:mb-12 border-b border-zinc-900 pb-6 md:pb-8">
      <div class="mb-4 text-fuchsia-500 font-mono text-xs uppercase tracking-widest flex items-center justify-center md:justify-start gap-2">
        <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-fuchsia-500 animate-pulse min-w-[6px]"></span>
        <time datetime={post.publish_date}>{displayDate}</time>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-6xl font-serif font-black tracking-tighter uppercase text-zinc-50 leading-none text-center md:text-left break-words">
        {post.theme_title}
      </h1>
    </header>

    {post.hero_image_url && (
      <figure class="mb-8 md:mb-12 aspect-[4/3] sm:aspect-[21/9] w-full overflow-hidden border border-zinc-800 rounded-sm">
        <img 
          src={post.hero_image_url} 
          alt={`Visual representation of ${post.theme_title}`} 
          class="w-full h-full object-cover mix-blend-luminosity hover:mix-blend-normal transition-all duration-700 hover:scale-105"
        />
      </figure>
    )}

    <!-- Custom Tailwind Typography styling defined in global.css `.sacred-prose` -->
    <div class="sacred-prose" set:html={contentHtml} />
    
    <nav class="mt-12 md:mt-20 border-t border-zinc-900 pt-6 md:pt-8 flex justify-center md:justify-start">
      <a href="/" class="inline-flex items-center text-sm font-mono text-zinc-500 hover:text-fuchsia-400 transition-colors uppercase tracking-widest group py-3 px-4 -mx-4 md:mx-0 border border-transparent md:border-none focus:outline-none focus:ring-1 focus:ring-fuchsia-500 md:focus:ring-0 rounded-sm">
        <span class="mr-2 group-hover:-translate-x-1 transition-transform">&larr;</span> Return to Void
      </a>
    </nav>
  </article>
</Layout>

<style>
  .fade-in {
    animation: fadeIn 0.8s ease-out forwards;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
